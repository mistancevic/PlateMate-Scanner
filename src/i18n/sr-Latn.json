  "safety": {
    "eating": {
      "text": "Ja sam kuvar, pa ovo nije nešto o čemu treba da savetujem. Pravi sagovornik je lekar ili terapeut koji radi s ishranom. Tvoj trener vidi da si mi to rekao, ali ne i šta si napisao. I dalje ti pomažem s namirnicama, tanjirima i količinama. Brojevi su tu da te informišu, nikad da te osuđuju.",
      "checked": false
    },
    "pregnancy": {
      "text": "Ja sam kuvar, a trudnoća i dojenje menjaju ono što ti telu treba. Tvoje ciljeve treba da odredi babica ili lekar. Donesi mi njihove brojeve i uklopiću tvoju hranu u njih. Neću predlagati da jedeš manje nego što trošiš, a tvoji tanjiri ostaju kakvi jesu.",
      "checked": false
    },
    "diabetes": {
      "text": "Ja sam kuvar. Kod dijabetesa ili insulina, vreme obroka i ugljene hidrate određuje tvoj lekar. Na svakom tanjiru pokazujem ugljene hidrate i šećere, i uklapam tvoju hranu u brojeve koje ti lekar odredi. Ne dajem savete o dozama ni o vremenu.",
      "checked": false
    },
    "allergies": {
      "text": "Zapisano. Neću predlagati ništa što sadrži ono što si naveo, i proveravam naziv i deklaraciju svake namirnice. Provera deklaracije i dalje pokazuje šta svako pakovanje sadrži, pa možeš i sam da proveriš.",
      "checked": false
    },
    "medication": {
      "text": "Ja sam kuvar, a neki lekovi menjaju kako hrana deluje u telu. Tvoj lekar ili farmaceut zna šta treba izbegavati. Reci mi koje namirnice, i izbaciću ih iz svakog predloga.",
      "checked": false
    },
    "off": {
      "text": "Razgovor sa Chef Mealanom je isključen za tvoj nalog dok ga tvoj trener ne potvrdi. Tanjiri, brojevi i tvoje namirnice rade kao i obično.",
      "checked": false
    }
  },
