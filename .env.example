# Local/manual calculation works without external service credentials.
# Copy to .env for local use; configure these in your hosting environment for deployment.
GEMINI_API_KEY=
# Set a model available to YOUR account. This preserves the existing project's model default.
GEMINI_MODEL=gemini-3.8-flash
# Required in production when AI or Airtable is configured. Share only with the pilot participant.
PILOT_ACCESS_KEY=
# Optional reviewed-food sync to existing Scans table. Never expose these in browser variables.
AIRTABLE_BASE_ID=
AIRTABLE_API_KEY=
PORT=3000

# Sign in with Google and cloud save (Firebase). Leave empty to run on the phone only.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Only if the Firestore database is not the default one
VITE_FIREBASE_DB_ID=
