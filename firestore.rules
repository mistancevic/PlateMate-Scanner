rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each person reads and writes their own document. A coach may read and update the documents of clients
    // who joined with the coach's code. Every lookup is guarded, so a document that does not exist yet never trips a rule.
    match /users/{uid} {
      function signedIn() { return request.auth != null; }
      function isOwner() { return signedIn() && request.auth.uid == uid; }
      function existing() { return resource != null && resource.data != null; }
      function isCoachOf() { return signedIn() && existing() && resource.data.get('coachId', '') == request.auth.uid; }
      function roleKept() { return request.resource.data.get('role', '') == (existing() ? resource.data.get('role', '') : ''); }
      function coachKept() { return request.resource.data.get('coachId', '') == (existing() ? resource.data.get('coachId', '') : ''); }
      allow get: if isOwner() || isCoachOf();
      allow list: if isOwner() || isCoachOf();
      allow create: if isOwner() && request.resource.data.get('role', '') == '';
      allow delete: if isOwner();
      allow update: if (isOwner() && roleKept()) || (isCoachOf() && roleKept() && coachKept());
      function coachOfParent() { return request.auth != null && get(/databases/$(database)/documents/users/$(uid)).data.get('coachId', '') == request.auth.uid; }
      // Photos: the owner reads and writes; the coach of that person reads.
      match /photos/{pid} {
        allow read: if request.auth != null && (request.auth.uid == uid || coachOfParent());
        allow write: if request.auth != null && request.auth.uid == uid;
      }
      // Inbox: recipes from the coach. Only the coach of that person creates; only the owner reads and deletes.
      match /inbox/{iid} {
        allow create: if coachOfParent() && request.resource.data.from == request.auth.uid;
        allow read, delete: if request.auth != null && request.auth.uid == uid;
      }
      // Cards: private by default. The owner reads and writes; the coach reads only cards marked shared.
      match /cards/{cid} {
        allow read: if request.auth != null && (request.auth.uid == uid || (coachOfParent() && resource.data.get('shared', false) == true));
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }
    // A coach's code: readable by any signed-in person, writable only by that coach.
    match /coaches/{code} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }
  }
}
