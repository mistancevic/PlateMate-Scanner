rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each person reads and writes their own document. A coach may read and update the documents of clients
    // who joined with the coach's code. Every lookup is guarded, so a document that does not exist yet never trips a rule.
    match /users/{uid} {
      function signedIn() { return request.auth != null; }
      function isOwner() { return signedIn() && request.auth.uid == uid; }
      function existing() { return resource != null && resource.data != null; }
      function isCoachOf() { return signedIn() && existing() && resource.data.get('coachId', '') == request.auth.uid; }
      function roleKept() { return request.resource.data.get('role', '') == (existing() ? resource.data.get('role', '') : ''); }
      function coachKept() { return request.resource.data.get('coachId', '') == (existing() ? resource.data.get('coachId', '') : ''); }
      allow get: if isOwner() || isCoachOf();
      allow list: if isOwner() || isCoachOf();
      // a person may keep or remove their coach link, never set one: joining goes through the server with a personal invite
      function coachLinkOk() { return coachKept() || request.resource.data.get('coachId', null) == null || request.resource.data.get('coachId', '') == ''; }
      // the coach's confirmation of Mealan's chat is the coach's to write, never the person's own
      function aiKept() { return request.resource.data.get('aiConfirmedAt', null) == (existing() ? resource.data.get('aiConfirmedAt', null) : null) && request.resource.data.get('aiConfirmedBy', null) == (existing() ? resource.data.get('aiConfirmedBy', null) : null); }
      allow create: if isOwner() && request.resource.data.get('role', '') == '' && request.resource.data.get('coachId', '') == '' && request.resource.data.get('aiConfirmedAt', null) == null;
      allow delete: if isOwner();
      // the coach's answer on the person's own numbers: the person may ask (waiting) or close, never approve or ask themselves to change
      function reviewOk() { return request.resource.data.get('numbersReview', null) == (existing() ? resource.data.get('numbersReview', null) : null) || request.resource.data.numbersReview.status in ['waiting', 'closed']; }
      allow update: if (isOwner() && roleKept() && coachLinkOk() && aiKept() && reviewOk()) || (isCoachOf() && roleKept() && coachKept());
      function coachOfParent() { return request.auth != null && get(/databases/$(database)/documents/users/$(uid)).data.get('coachId', '') == request.auth.uid; }
      // Photos: the owner reads and writes; the coach of that person reads.
      match /photos/{pid} {
        allow read: if request.auth != null && (request.auth.uid == uid || coachOfParent());
        allow write: if request.auth != null && request.auth.uid == uid;
      }
      // Inbox: recipes from the coach. Only the coach of that person creates; only the owner reads and deletes.
      match /inbox/{iid} {
        allow create: if coachOfParent() && request.resource.data.from == request.auth.uid;
        allow read, delete: if request.auth != null && request.auth.uid == uid;
      }
      // Foods and recipes, one record each (storage release 2, 7 October 2026): the owner's only. The coach sees a count.
      match /foods/{fid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /recipes/{rid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      // Cards: private by default. The owner reads and writes; the coach reads only cards marked shared.
      match /cards/{cid} {
        allow read: if request.auth != null && (request.auth.uid == uid || (coachOfParent() && resource.data.get('shared', false) == true));
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }
    // Invites and access requests are written and read by the server only.
    match /invites/{code} { allow read, write: if false; }
    match /accessRequests/{id} { allow read, write: if false; }
  }
}
